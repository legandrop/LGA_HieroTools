 Input {
  inputs 0
  name Input1
  xpos -217
  ypos 0
 }
 Dot {
  name Dot1
  xpos -183
  ypos 50
 }
 Crop {
  box {0 0 {width} {height}}
  name Crop_Format
  xpos -217
  ypos 70
 }
 BlinkScript {
  onCreate "__import__('LGA_NKS_BurnIn_Blink').setup(nuke.thisNode())"
  kernelSource "// LGA_RoundedPanels v0.08 | Lega\n// Fondos redondeados de los campos del burn-in, en una pasada.\n// SDF de rounded box + antialiasing 1px, con rotacion por campo.\n// v0.08: init() precalcula cada panel y su caja girada; process()\n//        solo hace la SDF dentro de esas cajas.\n// v0.06: 11 campos y franjas del modo Band (band_t/b/l/r).\n// v0.05: muestreo en el centro del pixel (pos + 0.5); defaults del gizmo.\n// v0.04: rotacion por campo (ax,ay = ancla; rot en radianes).\n\nkernel LGARoundedPanels : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite, eAccessPoint> dst;\n\n  param:\n    float clip_x;\n    float clip_y;\n    float clip_w;\n    float clip_h;\n    float clip_on;\n    float clip_ax;\n    float clip_ay;\n    float clip_rot;\n    float cspace_x;\n    float cspace_y;\n    float cspace_w;\n    float cspace_h;\n    float cspace_on;\n    float cspace_ax;\n    float cspace_ay;\n    float cspace_rot;\n    float res_x;\n    float res_y;\n    float res_w;\n    float res_h;\n    float res_on;\n    float res_ax;\n    float res_ay;\n    float res_rot;\n    float frame_x;\n    float frame_y;\n    float frame_w;\n    float frame_h;\n    float frame_on;\n    float frame_ax;\n    float frame_ay;\n    float frame_rot;\n    float tc_x;\n    float tc_y;\n    float tc_w;\n    float tc_h;\n    float tc_on;\n    float tc_ax;\n    float tc_ay;\n    float tc_rot;\n    float fps_x;\n    float fps_y;\n    float fps_w;\n    float fps_h;\n    float fps_on;\n    float fps_ax;\n    float fps_ay;\n    float fps_rot;\n    float track_x;\n    float track_y;\n    float track_w;\n    float track_h;\n    float track_on;\n    float track_ax;\n    float track_ay;\n    float track_rot;\n    float date_x;\n    float date_y;\n    float date_w;\n    float date_h;\n    float date_on;\n    float date_ax;\n    float date_ay;\n    float date_rot;\n    float codec_x;\n    float codec_y;\n    float codec_w;\n    float codec_h;\n    float codec_on;\n    float codec_ax;\n    float codec_ay;\n    float codec_rot;\n    float custom1_x;\n    float custom1_y;\n    float custom1_w;\n    float custom1_h;\n    float custom1_on;\n    float custom1_ax;\n    float custom1_ay;\n    float custom1_rot;\n    float custom2_x;\n    float custom2_y;\n    float custom2_w;\n    float custom2_h;\n    float custom2_on;\n    float custom2_ax;\n    float custom2_ay;\n    float custom2_rot;\n    float corner_radius;\n    float color_r;\n    float color_g;\n    float color_b;\n    float bg_opacity;\n    float band_t;\n    float band_b;\n    float band_l;\n    float band_r;\n    float fmt_w;\n    float fmt_h;\n    float rev;\n    float kver;\n\n  local:\n    float clip__en;\n    float clip__ca;\n    float clip__sa;\n    float clip__cx;\n    float clip__cy;\n    float clip__hw;\n    float clip__hh;\n    float clip__r;\n    float clip__bx0;\n    float clip__by0;\n    float clip__bx1;\n    float clip__by1;\n    float cspace__en;\n    float cspace__ca;\n    float cspace__sa;\n    float cspace__cx;\n    float cspace__cy;\n    float cspace__hw;\n    float cspace__hh;\n    float cspace__r;\n    float cspace__bx0;\n    float cspace__by0;\n    float cspace__bx1;\n    float cspace__by1;\n    float res__en;\n    float res__ca;\n    float res__sa;\n    float res__cx;\n    float res__cy;\n    float res__hw;\n    float res__hh;\n    float res__r;\n    float res__bx0;\n    float res__by0;\n    float res__bx1;\n    float res__by1;\n    float frame__en;\n    float frame__ca;\n    float frame__sa;\n    float frame__cx;\n    float frame__cy;\n    float frame__hw;\n    float frame__hh;\n    float frame__r;\n    float frame__bx0;\n    float frame__by0;\n    float frame__bx1;\n    float frame__by1;\n    float tc__en;\n    float tc__ca;\n    float tc__sa;\n    float tc__cx;\n    float tc__cy;\n    float tc__hw;\n    float tc__hh;\n    float tc__r;\n    float tc__bx0;\n    float tc__by0;\n    float tc__bx1;\n    float tc__by1;\n    float fps__en;\n    float fps__ca;\n    float fps__sa;\n    float fps__cx;\n    float fps__cy;\n    float fps__hw;\n    float fps__hh;\n    float fps__r;\n    float fps__bx0;\n    float fps__by0;\n    float fps__bx1;\n    float fps__by1;\n    float track__en;\n    float track__ca;\n    float track__sa;\n    float track__cx;\n    float track__cy;\n    float track__hw;\n    float track__hh;\n    float track__r;\n    float track__bx0;\n    float track__by0;\n    float track__bx1;\n    float track__by1;\n    float date__en;\n    float date__ca;\n    float date__sa;\n    float date__cx;\n    float date__cy;\n    float date__hw;\n    float date__hh;\n    float date__r;\n    float date__bx0;\n    float date__by0;\n    float date__bx1;\n    float date__by1;\n    float codec__en;\n    float codec__ca;\n    float codec__sa;\n    float codec__cx;\n    float codec__cy;\n    float codec__hw;\n    float codec__hh;\n    float codec__r;\n    float codec__bx0;\n    float codec__by0;\n    float codec__bx1;\n    float codec__by1;\n    float custom1__en;\n    float custom1__ca;\n    float custom1__sa;\n    float custom1__cx;\n    float custom1__cy;\n    float custom1__hw;\n    float custom1__hh;\n    float custom1__r;\n    float custom1__bx0;\n    float custom1__by0;\n    float custom1__bx1;\n    float custom1__by1;\n    float custom2__en;\n    float custom2__ca;\n    float custom2__sa;\n    float custom2__cx;\n    float custom2__cy;\n    float custom2__hw;\n    float custom2__hh;\n    float custom2__r;\n    float custom2__bx0;\n    float custom2__by0;\n    float custom2__bx1;\n    float custom2__by1;\n    float any_x0;\n    float any_y0;\n    float any_x1;\n    float any_y1;\n    float4 panel_col;\n\n  void define() \{\n    defineParam(clip_x, \"clip_x\", 0.0f);\n    defineParam(clip_y, \"clip_y\", 0.0f);\n    defineParam(clip_w, \"clip_w\", 0.0f);\n    defineParam(clip_h, \"clip_h\", 0.0f);\n    defineParam(clip_on, \"clip_on\", 0.0f);\n    defineParam(clip_ax, \"clip_ax\", 0.0f);\n    defineParam(clip_ay, \"clip_ay\", 0.0f);\n    defineParam(clip_rot, \"clip_rot\", 0.0f);\n    defineParam(cspace_x, \"cspace_x\", 0.0f);\n    defineParam(cspace_y, \"cspace_y\", 0.0f);\n    defineParam(cspace_w, \"cspace_w\", 0.0f);\n    defineParam(cspace_h, \"cspace_h\", 0.0f);\n    defineParam(cspace_on, \"cspace_on\", 0.0f);\n    defineParam(cspace_ax, \"cspace_ax\", 0.0f);\n    defineParam(cspace_ay, \"cspace_ay\", 0.0f);\n    defineParam(cspace_rot, \"cspace_rot\", 0.0f);\n    defineParam(res_x, \"res_x\", 0.0f);\n    defineParam(res_y, \"res_y\", 0.0f);\n    defineParam(res_w, \"res_w\", 0.0f);\n    defineParam(res_h, \"res_h\", 0.0f);\n    defineParam(res_on, \"res_on\", 0.0f);\n    defineParam(res_ax, \"res_ax\", 0.0f);\n    defineParam(res_ay, \"res_ay\", 0.0f);\n    defineParam(res_rot, \"res_rot\", 0.0f);\n    defineParam(frame_x, \"frame_x\", 0.0f);\n    defineParam(frame_y, \"frame_y\", 0.0f);\n    defineParam(frame_w, \"frame_w\", 0.0f);\n    defineParam(frame_h, \"frame_h\", 0.0f);\n    defineParam(frame_on, \"frame_on\", 0.0f);\n    defineParam(frame_ax, \"frame_ax\", 0.0f);\n    defineParam(frame_ay, \"frame_ay\", 0.0f);\n    defineParam(frame_rot, \"frame_rot\", 0.0f);\n    defineParam(tc_x, \"tc_x\", 0.0f);\n    defineParam(tc_y, \"tc_y\", 0.0f);\n    defineParam(tc_w, \"tc_w\", 0.0f);\n    defineParam(tc_h, \"tc_h\", 0.0f);\n    defineParam(tc_on, \"tc_on\", 0.0f);\n    defineParam(tc_ax, \"tc_ax\", 0.0f);\n    defineParam(tc_ay, \"tc_ay\", 0.0f);\n    defineParam(tc_rot, \"tc_rot\", 0.0f);\n    defineParam(fps_x, \"fps_x\", 0.0f);\n    defineParam(fps_y, \"fps_y\", 0.0f);\n    defineParam(fps_w, \"fps_w\", 0.0f);\n    defineParam(fps_h, \"fps_h\", 0.0f);\n    defineParam(fps_on, \"fps_on\", 0.0f);\n    defineParam(fps_ax, \"fps_ax\", 0.0f);\n    defineParam(fps_ay, \"fps_ay\", 0.0f);\n    defineParam(fps_rot, \"fps_rot\", 0.0f);\n    defineParam(track_x, \"track_x\", 0.0f);\n    defineParam(track_y, \"track_y\", 0.0f);\n    defineParam(track_w, \"track_w\", 0.0f);\n    defineParam(track_h, \"track_h\", 0.0f);\n    defineParam(track_on, \"track_on\", 0.0f);\n    defineParam(track_ax, \"track_ax\", 0.0f);\n    defineParam(track_ay, \"track_ay\", 0.0f);\n    defineParam(track_rot, \"track_rot\", 0.0f);\n    defineParam(date_x, \"date_x\", 0.0f);\n    defineParam(date_y, \"date_y\", 0.0f);\n    defineParam(date_w, \"date_w\", 0.0f);\n    defineParam(date_h, \"date_h\", 0.0f);\n    defineParam(date_on, \"date_on\", 0.0f);\n    defineParam(date_ax, \"date_ax\", 0.0f);\n    defineParam(date_ay, \"date_ay\", 0.0f);\n    defineParam(date_rot, \"date_rot\", 0.0f);\n    defineParam(codec_x, \"codec_x\", 0.0f);\n    defineParam(codec_y, \"codec_y\", 0.0f);\n    defineParam(codec_w, \"codec_w\", 0.0f);\n    defineParam(codec_h, \"codec_h\", 0.0f);\n    defineParam(codec_on, \"codec_on\", 0.0f);\n    defineParam(codec_ax, \"codec_ax\", 0.0f);\n    defineParam(codec_ay, \"codec_ay\", 0.0f);\n    defineParam(codec_rot, \"codec_rot\", 0.0f);\n    defineParam(custom1_x, \"custom1_x\", 0.0f);\n    defineParam(custom1_y, \"custom1_y\", 0.0f);\n    defineParam(custom1_w, \"custom1_w\", 0.0f);\n    defineParam(custom1_h, \"custom1_h\", 0.0f);\n    defineParam(custom1_on, \"custom1_on\", 0.0f);\n    defineParam(custom1_ax, \"custom1_ax\", 0.0f);\n    defineParam(custom1_ay, \"custom1_ay\", 0.0f);\n    defineParam(custom1_rot, \"custom1_rot\", 0.0f);\n    defineParam(custom2_x, \"custom2_x\", 0.0f);\n    defineParam(custom2_y, \"custom2_y\", 0.0f);\n    defineParam(custom2_w, \"custom2_w\", 0.0f);\n    defineParam(custom2_h, \"custom2_h\", 0.0f);\n    defineParam(custom2_on, \"custom2_on\", 0.0f);\n    defineParam(custom2_ax, \"custom2_ax\", 0.0f);\n    defineParam(custom2_ay, \"custom2_ay\", 0.0f);\n    defineParam(custom2_rot, \"custom2_rot\", 0.0f);\n    defineParam(corner_radius, \"corner_radius\", 11.0f);\n    defineParam(color_r, \"color_r\", 0.0f);\n    defineParam(color_g, \"color_g\", 0.0f);\n    defineParam(color_b, \"color_b\", 0.0f);\n    defineParam(bg_opacity, \"bg_opacity\", 0.65f);\n    defineParam(band_t, \"band_t\", 0.0f);\n    defineParam(band_b, \"band_b\", 0.0f);\n    defineParam(band_l, \"band_l\", 0.0f);\n    defineParam(band_r, \"band_r\", 0.0f);\n    defineParam(fmt_w, \"fmt_w\", 0.0f);\n    defineParam(fmt_h, \"fmt_h\", 0.0f);\n    defineParam(rev, \"rev\", 0.0f);\n    defineParam(kver, \"kver\", 8.0f);\n  \}\n\n  void init() \{\n    any_x0 = 1.0e9f;\n    any_y0 = 1.0e9f;\n    any_x1 = -1.0e9f;\n    any_y1 = -1.0e9f;\n    clip__en = (clip_on > 0.5f && clip_w > 0.0f && clip_h > 0.0f) ? 1.0f : 0.0f;\n    clip__ca = cos(clip_rot);\n    clip__sa = sin(clip_rot);\n    clip__cx = clip_x + clip_w * 0.5f;\n    clip__cy = clip_y + clip_h * 0.5f;\n    clip__hw = clip_w * 0.5f;\n    clip__hh = clip_h * 0.5f;\n    clip__r = min(corner_radius, min(clip_w, clip_h) * 0.5f);\n    \{\n      float X0 = clip__cx - clip_ax;\n      float Y0 = clip__cy - clip_ay;\n      float pcx = clip_ax + clip__ca * X0 - clip__sa * Y0;\n      float pcy = clip_ay + clip__sa * X0 + clip__ca * Y0;\n      float ex = fabs(clip__ca) * clip__hw + fabs(clip__sa) * clip__hh + 2.0f;\n      float ey = fabs(clip__sa) * clip__hw + fabs(clip__ca) * clip__hh + 2.0f;\n      clip__bx0 = pcx - ex;\n      clip__bx1 = pcx + ex;\n      clip__by0 = pcy - ey;\n      clip__by1 = pcy + ey;\n    \}\n    if (clip__en > 0.5f) \{\n      any_x0 = min(any_x0, clip__bx0);\n      any_y0 = min(any_y0, clip__by0);\n      any_x1 = max(any_x1, clip__bx1);\n      any_y1 = max(any_y1, clip__by1);\n    \}\n    cspace__en = (cspace_on > 0.5f && cspace_w > 0.0f && cspace_h > 0.0f) ? 1.0f : 0.0f;\n    cspace__ca = cos(cspace_rot);\n    cspace__sa = sin(cspace_rot);\n    cspace__cx = cspace_x + cspace_w * 0.5f;\n    cspace__cy = cspace_y + cspace_h * 0.5f;\n    cspace__hw = cspace_w * 0.5f;\n    cspace__hh = cspace_h * 0.5f;\n    cspace__r = min(corner_radius, min(cspace_w, cspace_h) * 0.5f);\n    \{\n      float X0 = cspace__cx - cspace_ax;\n      float Y0 = cspace__cy - cspace_ay;\n      float pcx = cspace_ax + cspace__ca * X0 - cspace__sa * Y0;\n      float pcy = cspace_ay + cspace__sa * X0 + cspace__ca * Y0;\n      float ex = fabs(cspace__ca) * cspace__hw + fabs(cspace__sa) * cspace__hh + 2.0f;\n      float ey = fabs(cspace__sa) * cspace__hw + fabs(cspace__ca) * cspace__hh + 2.0f;\n      cspace__bx0 = pcx - ex;\n      cspace__bx1 = pcx + ex;\n      cspace__by0 = pcy - ey;\n      cspace__by1 = pcy + ey;\n    \}\n    if (cspace__en > 0.5f) \{\n      any_x0 = min(any_x0, cspace__bx0);\n      any_y0 = min(any_y0, cspace__by0);\n      any_x1 = max(any_x1, cspace__bx1);\n      any_y1 = max(any_y1, cspace__by1);\n    \}\n    res__en = (res_on > 0.5f && res_w > 0.0f && res_h > 0.0f) ? 1.0f : 0.0f;\n    res__ca = cos(res_rot);\n    res__sa = sin(res_rot);\n    res__cx = res_x + res_w * 0.5f;\n    res__cy = res_y + res_h * 0.5f;\n    res__hw = res_w * 0.5f;\n    res__hh = res_h * 0.5f;\n    res__r = min(corner_radius, min(res_w, res_h) * 0.5f);\n    \{\n      float X0 = res__cx - res_ax;\n      float Y0 = res__cy - res_ay;\n      float pcx = res_ax + res__ca * X0 - res__sa * Y0;\n      float pcy = res_ay + res__sa * X0 + res__ca * Y0;\n      float ex = fabs(res__ca) * res__hw + fabs(res__sa) * res__hh + 2.0f;\n      float ey = fabs(res__sa) * res__hw + fabs(res__ca) * res__hh + 2.0f;\n      res__bx0 = pcx - ex;\n      res__bx1 = pcx + ex;\n      res__by0 = pcy - ey;\n      res__by1 = pcy + ey;\n    \}\n    if (res__en > 0.5f) \{\n      any_x0 = min(any_x0, res__bx0);\n      any_y0 = min(any_y0, res__by0);\n      any_x1 = max(any_x1, res__bx1);\n      any_y1 = max(any_y1, res__by1);\n    \}\n    frame__en = (frame_on > 0.5f && frame_w > 0.0f && frame_h > 0.0f) ? 1.0f : 0.0f;\n    frame__ca = cos(frame_rot);\n    frame__sa = sin(frame_rot);\n    frame__cx = frame_x + frame_w * 0.5f;\n    frame__cy = frame_y + frame_h * 0.5f;\n    frame__hw = frame_w * 0.5f;\n    frame__hh = frame_h * 0.5f;\n    frame__r = min(corner_radius, min(frame_w, frame_h) * 0.5f);\n    \{\n      float X0 = frame__cx - frame_ax;\n      float Y0 = frame__cy - frame_ay;\n      float pcx = frame_ax + frame__ca * X0 - frame__sa * Y0;\n      float pcy = frame_ay + frame__sa * X0 + frame__ca * Y0;\n      float ex = fabs(frame__ca) * frame__hw + fabs(frame__sa) * frame__hh + 2.0f;\n      float ey = fabs(frame__sa) * frame__hw + fabs(frame__ca) * frame__hh + 2.0f;\n      frame__bx0 = pcx - ex;\n      frame__bx1 = pcx + ex;\n      frame__by0 = pcy - ey;\n      frame__by1 = pcy + ey;\n    \}\n    if (frame__en > 0.5f) \{\n      any_x0 = min(any_x0, frame__bx0);\n      any_y0 = min(any_y0, frame__by0);\n      any_x1 = max(any_x1, frame__bx1);\n      any_y1 = max(any_y1, frame__by1);\n    \}\n    tc__en = (tc_on > 0.5f && tc_w > 0.0f && tc_h > 0.0f) ? 1.0f : 0.0f;\n    tc__ca = cos(tc_rot);\n    tc__sa = sin(tc_rot);\n    tc__cx = tc_x + tc_w * 0.5f;\n    tc__cy = tc_y + tc_h * 0.5f;\n    tc__hw = tc_w * 0.5f;\n    tc__hh = tc_h * 0.5f;\n    tc__r = min(corner_radius, min(tc_w, tc_h) * 0.5f);\n    \{\n      float X0 = tc__cx - tc_ax;\n      float Y0 = tc__cy - tc_ay;\n      float pcx = tc_ax + tc__ca * X0 - tc__sa * Y0;\n      float pcy = tc_ay + tc__sa * X0 + tc__ca * Y0;\n      float ex = fabs(tc__ca) * tc__hw + fabs(tc__sa) * tc__hh + 2.0f;\n      float ey = fabs(tc__sa) * tc__hw + fabs(tc__ca) * tc__hh + 2.0f;\n      tc__bx0 = pcx - ex;\n      tc__bx1 = pcx + ex;\n      tc__by0 = pcy - ey;\n      tc__by1 = pcy + ey;\n    \}\n    if (tc__en > 0.5f) \{\n      any_x0 = min(any_x0, tc__bx0);\n      any_y0 = min(any_y0, tc__by0);\n      any_x1 = max(any_x1, tc__bx1);\n      any_y1 = max(any_y1, tc__by1);\n    \}\n    fps__en = (fps_on > 0.5f && fps_w > 0.0f && fps_h > 0.0f) ? 1.0f : 0.0f;\n    fps__ca = cos(fps_rot);\n    fps__sa = sin(fps_rot);\n    fps__cx = fps_x + fps_w * 0.5f;\n    fps__cy = fps_y + fps_h * 0.5f;\n    fps__hw = fps_w * 0.5f;\n    fps__hh = fps_h * 0.5f;\n    fps__r = min(corner_radius, min(fps_w, fps_h) * 0.5f);\n    \{\n      float X0 = fps__cx - fps_ax;\n      float Y0 = fps__cy - fps_ay;\n      float pcx = fps_ax + fps__ca * X0 - fps__sa * Y0;\n      float pcy = fps_ay + fps__sa * X0 + fps__ca * Y0;\n      float ex = fabs(fps__ca) * fps__hw + fabs(fps__sa) * fps__hh + 2.0f;\n      float ey = fabs(fps__sa) * fps__hw + fabs(fps__ca) * fps__hh + 2.0f;\n      fps__bx0 = pcx - ex;\n      fps__bx1 = pcx + ex;\n      fps__by0 = pcy - ey;\n      fps__by1 = pcy + ey;\n    \}\n    if (fps__en > 0.5f) \{\n      any_x0 = min(any_x0, fps__bx0);\n      any_y0 = min(any_y0, fps__by0);\n      any_x1 = max(any_x1, fps__bx1);\n      any_y1 = max(any_y1, fps__by1);\n    \}\n    track__en = (track_on > 0.5f && track_w > 0.0f && track_h > 0.0f) ? 1.0f : 0.0f;\n    track__ca = cos(track_rot);\n    track__sa = sin(track_rot);\n    track__cx = track_x + track_w * 0.5f;\n    track__cy = track_y + track_h * 0.5f;\n    track__hw = track_w * 0.5f;\n    track__hh = track_h * 0.5f;\n    track__r = min(corner_radius, min(track_w, track_h) * 0.5f);\n    \{\n      float X0 = track__cx - track_ax;\n      float Y0 = track__cy - track_ay;\n      float pcx = track_ax + track__ca * X0 - track__sa * Y0;\n      float pcy = track_ay + track__sa * X0 + track__ca * Y0;\n      float ex = fabs(track__ca) * track__hw + fabs(track__sa) * track__hh + 2.0f;\n      float ey = fabs(track__sa) * track__hw + fabs(track__ca) * track__hh + 2.0f;\n      track__bx0 = pcx - ex;\n      track__bx1 = pcx + ex;\n      track__by0 = pcy - ey;\n      track__by1 = pcy + ey;\n    \}\n    if (track__en > 0.5f) \{\n      any_x0 = min(any_x0, track__bx0);\n      any_y0 = min(any_y0, track__by0);\n      any_x1 = max(any_x1, track__bx1);\n      any_y1 = max(any_y1, track__by1);\n    \}\n    date__en = (date_on > 0.5f && date_w > 0.0f && date_h > 0.0f) ? 1.0f : 0.0f;\n    date__ca = cos(date_rot);\n    date__sa = sin(date_rot);\n    date__cx = date_x + date_w * 0.5f;\n    date__cy = date_y + date_h * 0.5f;\n    date__hw = date_w * 0.5f;\n    date__hh = date_h * 0.5f;\n    date__r = min(corner_radius, min(date_w, date_h) * 0.5f);\n    \{\n      float X0 = date__cx - date_ax;\n      float Y0 = date__cy - date_ay;\n      float pcx = date_ax + date__ca * X0 - date__sa * Y0;\n      float pcy = date_ay + date__sa * X0 + date__ca * Y0;\n      float ex = fabs(date__ca) * date__hw + fabs(date__sa) * date__hh + 2.0f;\n      float ey = fabs(date__sa) * date__hw + fabs(date__ca) * date__hh + 2.0f;\n      date__bx0 = pcx - ex;\n      date__bx1 = pcx + ex;\n      date__by0 = pcy - ey;\n      date__by1 = pcy + ey;\n    \}\n    if (date__en > 0.5f) \{\n      any_x0 = min(any_x0, date__bx0);\n      any_y0 = min(any_y0, date__by0);\n      any_x1 = max(any_x1, date__bx1);\n      any_y1 = max(any_y1, date__by1);\n    \}\n    codec__en = (codec_on > 0.5f && codec_w > 0.0f && codec_h > 0.0f) ? 1.0f : 0.0f;\n    codec__ca = cos(codec_rot);\n    codec__sa = sin(codec_rot);\n    codec__cx = codec_x + codec_w * 0.5f;\n    codec__cy = codec_y + codec_h * 0.5f;\n    codec__hw = codec_w * 0.5f;\n    codec__hh = codec_h * 0.5f;\n    codec__r = min(corner_radius, min(codec_w, codec_h) * 0.5f);\n    \{\n      float X0 = codec__cx - codec_ax;\n      float Y0 = codec__cy - codec_ay;\n      float pcx = codec_ax + codec__ca * X0 - codec__sa * Y0;\n      float pcy = codec_ay + codec__sa * X0 + codec__ca * Y0;\n      float ex = fabs(codec__ca) * codec__hw + fabs(codec__sa) * codec__hh + 2.0f;\n      float ey = fabs(codec__sa) * codec__hw + fabs(codec__ca) * codec__hh + 2.0f;\n      codec__bx0 = pcx - ex;\n      codec__bx1 = pcx + ex;\n      codec__by0 = pcy - ey;\n      codec__by1 = pcy + ey;\n    \}\n    if (codec__en > 0.5f) \{\n      any_x0 = min(any_x0, codec__bx0);\n      any_y0 = min(any_y0, codec__by0);\n      any_x1 = max(any_x1, codec__bx1);\n      any_y1 = max(any_y1, codec__by1);\n    \}\n    custom1__en = (custom1_on > 0.5f && custom1_w > 0.0f && custom1_h > 0.0f) ? 1.0f : 0.0f;\n    custom1__ca = cos(custom1_rot);\n    custom1__sa = sin(custom1_rot);\n    custom1__cx = custom1_x + custom1_w * 0.5f;\n    custom1__cy = custom1_y + custom1_h * 0.5f;\n    custom1__hw = custom1_w * 0.5f;\n    custom1__hh = custom1_h * 0.5f;\n    custom1__r = min(corner_radius, min(custom1_w, custom1_h) * 0.5f);\n    \{\n      float X0 = custom1__cx - custom1_ax;\n      float Y0 = custom1__cy - custom1_ay;\n      float pcx = custom1_ax + custom1__ca * X0 - custom1__sa * Y0;\n      float pcy = custom1_ay + custom1__sa * X0 + custom1__ca * Y0;\n      float ex = fabs(custom1__ca) * custom1__hw + fabs(custom1__sa) * custom1__hh + 2.0f;\n      float ey = fabs(custom1__sa) * custom1__hw + fabs(custom1__ca) * custom1__hh + 2.0f;\n      custom1__bx0 = pcx - ex;\n      custom1__bx1 = pcx + ex;\n      custom1__by0 = pcy - ey;\n      custom1__by1 = pcy + ey;\n    \}\n    if (custom1__en > 0.5f) \{\n      any_x0 = min(any_x0, custom1__bx0);\n      any_y0 = min(any_y0, custom1__by0);\n      any_x1 = max(any_x1, custom1__bx1);\n      any_y1 = max(any_y1, custom1__by1);\n    \}\n    custom2__en = (custom2_on > 0.5f && custom2_w > 0.0f && custom2_h > 0.0f) ? 1.0f : 0.0f;\n    custom2__ca = cos(custom2_rot);\n    custom2__sa = sin(custom2_rot);\n    custom2__cx = custom2_x + custom2_w * 0.5f;\n    custom2__cy = custom2_y + custom2_h * 0.5f;\n    custom2__hw = custom2_w * 0.5f;\n    custom2__hh = custom2_h * 0.5f;\n    custom2__r = min(corner_radius, min(custom2_w, custom2_h) * 0.5f);\n    \{\n      float X0 = custom2__cx - custom2_ax;\n      float Y0 = custom2__cy - custom2_ay;\n      float pcx = custom2_ax + custom2__ca * X0 - custom2__sa * Y0;\n      float pcy = custom2_ay + custom2__sa * X0 + custom2__ca * Y0;\n      float ex = fabs(custom2__ca) * custom2__hw + fabs(custom2__sa) * custom2__hh + 2.0f;\n      float ey = fabs(custom2__sa) * custom2__hw + fabs(custom2__ca) * custom2__hh + 2.0f;\n      custom2__bx0 = pcx - ex;\n      custom2__bx1 = pcx + ex;\n      custom2__by0 = pcy - ey;\n      custom2__by1 = pcy + ey;\n    \}\n    if (custom2__en > 0.5f) \{\n      any_x0 = min(any_x0, custom2__bx0);\n      any_y0 = min(any_y0, custom2__by0);\n      any_x1 = max(any_x1, custom2__bx1);\n      any_y1 = max(any_y1, custom2__by1);\n    \}\n    panel_col = float4(color_r, color_g, color_b, 1.0f);\n  \}\n\n  void process(int2 pos) \{\n    SampleType(src) input = src();\n    float ppx = float(pos.x) + 0.5f;\n    float ppy = float(pos.y) + 0.5f;\n    float a = 0.0f;\n\n    // franjas del modo Band (grosor en px desde cada borde)\n    if (band_b > 0.0f && ppy < band_b) a = 1.0f;\n    if (band_t > 0.0f && ppy > fmt_h - band_t) a = 1.0f;\n    if (band_l > 0.0f && ppx < band_l) a = 1.0f;\n    if (band_r > 0.0f && ppx > fmt_w - band_r) a = 1.0f;\n\n    // paneles: solo dentro de la union de sus cajas\n    if (a < 1.0f && ppx >= any_x0 && ppx <= any_x1 && ppy >= any_y0 && ppy <= any_y1) \{\n      if (clip__en > 0.5f && ppx >= clip__bx0 && ppx <= clip__bx1 && ppy >= clip__by0 && ppy <= clip__by1) \{\n        float rx = ppx - clip_ax;\n        float ry = ppy - clip_ay;\n        float lx = clip__ca * rx + clip__sa * ry + clip_ax - clip__cx;\n        float ly = -clip__sa * rx + clip__ca * ry + clip_ay - clip__cy;\n        float dx = fabs(lx) - (clip__hw - clip__r);\n        float dy = fabs(ly) - (clip__hh - clip__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - clip__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (cspace__en > 0.5f && ppx >= cspace__bx0 && ppx <= cspace__bx1 && ppy >= cspace__by0 && ppy <= cspace__by1) \{\n        float rx = ppx - cspace_ax;\n        float ry = ppy - cspace_ay;\n        float lx = cspace__ca * rx + cspace__sa * ry + cspace_ax - cspace__cx;\n        float ly = -cspace__sa * rx + cspace__ca * ry + cspace_ay - cspace__cy;\n        float dx = fabs(lx) - (cspace__hw - cspace__r);\n        float dy = fabs(ly) - (cspace__hh - cspace__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - cspace__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (res__en > 0.5f && ppx >= res__bx0 && ppx <= res__bx1 && ppy >= res__by0 && ppy <= res__by1) \{\n        float rx = ppx - res_ax;\n        float ry = ppy - res_ay;\n        float lx = res__ca * rx + res__sa * ry + res_ax - res__cx;\n        float ly = -res__sa * rx + res__ca * ry + res_ay - res__cy;\n        float dx = fabs(lx) - (res__hw - res__r);\n        float dy = fabs(ly) - (res__hh - res__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - res__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (frame__en > 0.5f && ppx >= frame__bx0 && ppx <= frame__bx1 && ppy >= frame__by0 && ppy <= frame__by1) \{\n        float rx = ppx - frame_ax;\n        float ry = ppy - frame_ay;\n        float lx = frame__ca * rx + frame__sa * ry + frame_ax - frame__cx;\n        float ly = -frame__sa * rx + frame__ca * ry + frame_ay - frame__cy;\n        float dx = fabs(lx) - (frame__hw - frame__r);\n        float dy = fabs(ly) - (frame__hh - frame__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - frame__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (tc__en > 0.5f && ppx >= tc__bx0 && ppx <= tc__bx1 && ppy >= tc__by0 && ppy <= tc__by1) \{\n        float rx = ppx - tc_ax;\n        float ry = ppy - tc_ay;\n        float lx = tc__ca * rx + tc__sa * ry + tc_ax - tc__cx;\n        float ly = -tc__sa * rx + tc__ca * ry + tc_ay - tc__cy;\n        float dx = fabs(lx) - (tc__hw - tc__r);\n        float dy = fabs(ly) - (tc__hh - tc__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - tc__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (fps__en > 0.5f && ppx >= fps__bx0 && ppx <= fps__bx1 && ppy >= fps__by0 && ppy <= fps__by1) \{\n        float rx = ppx - fps_ax;\n        float ry = ppy - fps_ay;\n        float lx = fps__ca * rx + fps__sa * ry + fps_ax - fps__cx;\n        float ly = -fps__sa * rx + fps__ca * ry + fps_ay - fps__cy;\n        float dx = fabs(lx) - (fps__hw - fps__r);\n        float dy = fabs(ly) - (fps__hh - fps__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - fps__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (track__en > 0.5f && ppx >= track__bx0 && ppx <= track__bx1 && ppy >= track__by0 && ppy <= track__by1) \{\n        float rx = ppx - track_ax;\n        float ry = ppy - track_ay;\n        float lx = track__ca * rx + track__sa * ry + track_ax - track__cx;\n        float ly = -track__sa * rx + track__ca * ry + track_ay - track__cy;\n        float dx = fabs(lx) - (track__hw - track__r);\n        float dy = fabs(ly) - (track__hh - track__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - track__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (date__en > 0.5f && ppx >= date__bx0 && ppx <= date__bx1 && ppy >= date__by0 && ppy <= date__by1) \{\n        float rx = ppx - date_ax;\n        float ry = ppy - date_ay;\n        float lx = date__ca * rx + date__sa * ry + date_ax - date__cx;\n        float ly = -date__sa * rx + date__ca * ry + date_ay - date__cy;\n        float dx = fabs(lx) - (date__hw - date__r);\n        float dy = fabs(ly) - (date__hh - date__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - date__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (codec__en > 0.5f && ppx >= codec__bx0 && ppx <= codec__bx1 && ppy >= codec__by0 && ppy <= codec__by1) \{\n        float rx = ppx - codec_ax;\n        float ry = ppy - codec_ay;\n        float lx = codec__ca * rx + codec__sa * ry + codec_ax - codec__cx;\n        float ly = -codec__sa * rx + codec__ca * ry + codec_ay - codec__cy;\n        float dx = fabs(lx) - (codec__hw - codec__r);\n        float dy = fabs(ly) - (codec__hh - codec__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - codec__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (custom1__en > 0.5f && ppx >= custom1__bx0 && ppx <= custom1__bx1 && ppy >= custom1__by0 && ppy <= custom1__by1) \{\n        float rx = ppx - custom1_ax;\n        float ry = ppy - custom1_ay;\n        float lx = custom1__ca * rx + custom1__sa * ry + custom1_ax - custom1__cx;\n        float ly = -custom1__sa * rx + custom1__ca * ry + custom1_ay - custom1__cy;\n        float dx = fabs(lx) - (custom1__hw - custom1__r);\n        float dy = fabs(ly) - (custom1__hh - custom1__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - custom1__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n      if (custom2__en > 0.5f && ppx >= custom2__bx0 && ppx <= custom2__bx1 && ppy >= custom2__by0 && ppy <= custom2__by1) \{\n        float rx = ppx - custom2_ax;\n        float ry = ppy - custom2_ay;\n        float lx = custom2__ca * rx + custom2__sa * ry + custom2_ax - custom2__cx;\n        float ly = -custom2__sa * rx + custom2__ca * ry + custom2_ay - custom2__cy;\n        float dx = fabs(lx) - (custom2__hw - custom2__r);\n        float dy = fabs(ly) - (custom2__hh - custom2__r);\n        float qx = max(dx, 0.0f);\n        float qy = max(dy, 0.0f);\n        float dist = sqrt(qx * qx + qy * qy) + min(max(dx, dy), 0.0f) - custom2__r;\n        a = max(a, clamp(0.5f - dist, 0.0f, 1.0f));\n      \}\n    \}\n\n    if (a > 0.0f) \{\n      a = a * bg_opacity;\n      dst() = input * (1.0f - a) + panel_col * a;\n    \} else \{\n      dst() = input;\n    \}\n  \}\n\};\n"
  rebuild ""
  rebuild_finalise ""
  name Blink_Panels
  xpos -217
  ypos 100
 }

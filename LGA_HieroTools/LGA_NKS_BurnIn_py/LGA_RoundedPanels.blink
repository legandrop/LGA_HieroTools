    float custom1__by0;
    float custom1__bx1;
    float custom1__by1;
    float custom2__en;
    float custom2__ca;
    float custom2__sa;
    float custom2__cx;
    float custom2__cy;
    float custom2__hw;
    float custom2__hh;
    float custom2__r;
    float custom2__bx0;
    float custom2__by0;

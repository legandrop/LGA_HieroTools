    float fps_x;
    float fps_y;
    float fps_w;
    float fps_h;
    float fps_on;
    float fps_ax;
    float fps_ay;
    float fps_rot;
    float track_x;
    float track_y;
    float track_w;
    float track_h;
    float track_on;
    float track_ax;
    float track_ay;
    float track_rot;
    float date_x;
    float date_y;
    float date_w;
    float date_h;

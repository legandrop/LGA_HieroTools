    float date_rot;
    float codec_x;
    float codec_y;
    float codec_w;
    float codec_h;
    float codec_on;
    float codec_ax;
    float codec_ay;
    float codec_rot;
    float custom1_x;
    float custom1_y;
    float custom1_w;
    float custom1_h;
    float custom1_on;
    float custom1_ax;
    float custom1_ay;
    float custom1_rot;

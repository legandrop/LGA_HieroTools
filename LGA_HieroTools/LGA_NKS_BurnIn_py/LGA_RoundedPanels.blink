    float track__sa;
    float track__cx;
    float track__cy;
    float track__hw;
    float track__hh;
    float track__r;
    float track__bx0;
    float track__by0;
    float track__bx1;
    float track__by1;
    float date__en;
    float date__ca;
    float date__sa;
    float date__cx;
    float date__cy;
    float date__hw;
    float date__hh;
    float date__r;
    float date__bx0;
    float date__by0;
    float date__bx1;
    float date__by1;
    float codec__en;
    float codec__ca;
    float codec__sa;
    float codec__cx;
    float codec__cy;
    float codec__hw;
    float codec__hh;
    float codec__r;
    float codec__bx0;
